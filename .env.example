# Example environment configuration
# Copy to .env and update with your actual values

FLASK_ENV=development
APP_NAME=llm
APP_AUTHOR=Ali Jutt
SECRET_KEY=your-64-char-hex-key-here
PORT=5000
HOST=::

# Database
DATABASE_URL=sqlite:///llm.db

# Encryption
ENCRYPTION_KEY=your-64-char-hex-key-here

# Rate limiting
PROXY_RATE_LIMIT_RPM=120
ADMIN_RATE_LIMIT_RPM=600
REQUEST_BODY_LIMIT_MB=25

# Provider timeouts (ms)
PROVIDER_TIMEOUT_DEFAULT=60000
PROVIDER_STREAM_STALL_TIMEOUT_MS=90000
FALLBACK_TIME_BUDGET_MS=45000

# Cache
RESPONSE_CACHE=false
RESPONSE_CACHE_TTL_SECONDS=3600
RESPONSE_CACHE_MAX_ENTRIES=5000

# Analytics
REQUEST_ANALYTICS_RETENTION_DAYS=90
REQUEST_ANALYTICS_MAX_ROWS=100000
REQUEST_ANALYTICS_LOG_CLIENT=true

# Proxy settings
# PROXY_URL=socks5h://127.0.0.1:1080
# NO_PROXY=localhost,127.0.0.1

# Custom provider security
# FREEAPI_BLOCK_PRIVATE_PROVIDER_URLS=false

# Compression
FREELLMAPI_COMPRESSION=off

# Update checker
FREELLMAPI_UPDATE_CHECK=off

# Dashboard origins
DASHBOARD_ORIGINS=localhost:5173,127.0.0.1:5173,[::1]:5173

# Context handoff
FREELLMAPI_CONTEXT_HANDOFF=on_model_switch

# Trust proxy headers
# TRUST_PROXY=false
